{
  "name": "@hostily/captcha-svelte",
  "version": "0.1.0",
  "description": "Svelte 4 and 5 component for hostily Captcha (captcha.hostily.de): thin wrapper around the <hostily-captcha> web component. SSR-safe (SvelteKit).",
  "license": "MIT",
  "author": "connect - Media & Teledienst",
  "keywords": ["captcha", "svelte", "sveltekit", "spam", "recaptcha-alternative", "proof-of-work"],
  "homepage": "https://captcha.hostily.de",
  "repository": { "type": "git", "url": "git+https://github.com/connect-gruppe/hostily-captcha-svelte.git" },
  "bugs": { "url": "https://github.com/connect-gruppe/hostily-captcha-svelte/issues" },
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "svelte": "./dist/index.js", "default": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["**/*.css"],
  "peerDependencies": { "svelte": "^4.0.0 || ^5.0.0" },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && cp src/lib/index.d.ts dist/index.d.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "svelte": "^5.0.0",
    "typescript": "^5.5.0"
  }
}
